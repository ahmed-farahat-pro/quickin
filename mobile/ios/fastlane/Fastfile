require "base64"
require "digest"
require "shellwords"

default_platform(:ios)

APP_IDENTIFIER = "com.quickin.ahmed".freeze
XCODEPROJ      = "QuickIn.xcodeproj".freeze
SCHEME         = "QuickIn".freeze

# GitHub materialises an *unset* secret as an empty string rather than leaving
# the variable out, so ENV.fetch happily returns "" and the failure surfaces
# much later as `invalid curve name` from OpenSSL. Check up front, and report
# every missing name at once instead of one per run.
def require_env!(*keys)
  missing = keys.flatten.select { |key| ENV[key].to_s.empty? }
  return if missing.empty?

  UI.user_error!(
    "Missing or empty: #{missing.join(', ')}. " \
    "On CI these come from repository secrets; locally, export them in the " \
    "same shell that runs fastlane."
  )
end

SIGNING_ENV = %w[
  APPLE_TEAM_ID
  MATCH_GIT_URL MATCH_GIT_USER MATCH_GIT_TOKEN MATCH_PASSWORD
  APP_STORE_KEY_ID APP_STORE_ISSUER_ID APP_STORE_API_KEY_P8
].freeze

# Returns the SHA-1 of the certificate embedded in a .mobileprovision, which
# xcodebuild accepts as CODE_SIGN_IDENTITY.
#
# Naming the identity "Apple Distribution" instead is ambiguous on a developer
# Mac: this team has issued several distribution certs over the years and they
# all share one common name, so xcodebuild picks whichever it finds first and
# the archive dies with "Provisioning profile ... doesn't include signing
# certificate". CI never hits this — setup_ci's throwaway keychain holds only
# the cert match just installed — but pinning the hash is correct in both.
def profile_certificate_sha1(profile_path)
  return nil if profile_path.to_s.empty? || !File.exist?(profile_path)

  cmd = "security cms -D -i #{Shellwords.escape(profile_path)} 2>/dev/null | " \
        "plutil -extract DeveloperCertificates.0 raw -o - - | base64 -d"
  der = IO.popen(["/bin/sh", "-c", cmd], "rb", &:read)
  return nil if der.nil? || der.empty?

  Digest::SHA1.hexdigest(der).upcase
end

# App Store version states that are closed to new builds. Once a version reaches
# any of these, Apple refuses every upload carrying that CFBundleShortVersionString
# with 90186 ("train version is closed") and 90062 ("must contain a higher version
# than that of the previously approved version").
CLOSED_APP_STORE_STATES = %w[
  ACCEPTED
  PROCESSING_FOR_APP_STORE PROCESSING_FOR_DISTRIBUTION
  PENDING_APPLE_RELEASE PENDING_DEVELOPER_RELEASE
  READY_FOR_SALE READY_FOR_DISTRIBUTION PREORDER_READY_FOR_SALE
  REPLACED_WITH_NEW_VERSION
  REMOVED_FROM_SALE DEVELOPER_REMOVED_FROM_SALE
].freeze

# Authenticates spaceship with the same key the fastlane actions use, and
# returns the App Store Connect app record (nil if the key cannot see it).
def asc_app(api_key)
  require "spaceship"

  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
end

# Highest CFBundleVersion App Store Connect has ever accepted for this app,
# across every marketing-version train.
#
# latest_testflight_build_number cannot answer this. It asks the buildUploads
# endpoint filtered to `state: PROCESSING,FAILED,COMPLETE`, sorted by upload
# date, limit 1 — so it reports the *newest* upload still in one of those three
# states. An upload that ended INVALID, or that has since expired, has burned
# its build number permanently and is invisible to that query: the lane picks a
# number Apple then rejects with ENTITY_ERROR.ATTRIBUTE.INVALID.DUPLICATE ("the
# bundle version must be higher than the previously uploaded version"), after a
# full archive has already been paid for. On 2026-08-22 that query answered 6
# while Apple's real floor was 27.
#
# The builds endpoint keeps INVALID uploads, so scan it across all four
# processing states and take the highest number rather than the newest one.
# Returns 0 if the scan fails — the other floors still apply.
def highest_build_number_on_asc(api_key)
  app = asc_app(api_key)
  return 0 if app.nil?

  builds = Spaceship::ConnectAPI::Build.all(
    app_id: app.id,
    processing_states: "PROCESSING,FAILED,INVALID,VALID",
    includes: nil,
    limit: 200
  )
  # A build number may be dotted ("1.2.3"); compare on the leading integer,
  # which is all this app has ever shipped.
  builds.map { |build| build.version.to_i }.max.to_i
rescue StandardError => e
  UI.important("Could not scan App Store Connect builds (#{e.message}) — " \
               "falling back to the TestFlight and project.yml floors.")
  0
end

# Highest marketing version that is closed to new builds, or nil if none is.
#
# Returns nil rather than raising when the lookup itself fails: an API hiccup
# should not block a deploy, and upload_to_testflight still catches a closed
# train — just 60 seconds of archiving later.
def highest_closed_marketing_version(api_key)
  app = asc_app(api_key)
  return nil if app.nil?

  versions = app.get_app_store_versions(includes: nil)
  closed = versions.select do |version|
    # app_store_state is deprecated in App Store Connect API 3.3 in favour of
    # app_version_state, and which one is populated depends on the API version
    # spaceship negotiates. Read whichever is there.
    state = version.app_version_state || version.app_store_state
    CLOSED_APP_STORE_STATES.include?(state)
  end

  closed.filter_map { |version| Gem::Version.new(version.version_string) rescue nil }.max
rescue StandardError => e
  UI.important("Could not read App Store versions (#{e.message}) — " \
               "skipping the closed-train check.")
  nil
end

# Fails the lane before build_app if MARKETING_VERSION is one Apple will not
# accept. Without this the rejection lands in upload_to_testflight, after a full
# archive, export and upload have already run.
def assert_marketing_version_is_open!(api_key, marketing_version)
  closed = highest_closed_marketing_version(api_key)
  return if closed.nil?

  UI.message("Highest closed marketing version on App Store Connect: #{closed}")
  return if Gem::Version.new(marketing_version) > closed

  segments = closed.segments
  suggestion = [segments[0].to_i, segments[1].to_i + 1, 0].join(".")

  UI.user_error!(
    "MARKETING_VERSION #{marketing_version} is closed for new builds — " \
    "#{closed} is already approved on App Store Connect. Every upload needs a " \
    "marketing version higher than anything approved, so bump MARKETING_VERSION " \
    "in project.yml (#{marketing_version} -> #{suggestion}) and re-run. Check the " \
    "version list on App Store Connect first rather than incrementing blindly."
  )
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_ISSUER_ID"),
    # Raw .p8 contents, NOT base64 — fastlane has reverted base64 .p8 decoding
    # in the transporter path before, and upload_to_testflight regenerates a
    # .p8 file from this. GitHub secrets preserve the multi-line PEM fine.
    key_content: ENV.fetch("APP_STORE_API_KEY_P8"),
    is_key_content_base64: false,
    in_house: false
  )
end

# match clones the repo over HTTPS, so it needs basic-auth credentials rather
# than the ambient SSH key a developer's Mac would use.
def match_git_auth
  Base64.strict_encode64(
    "#{ENV.fetch('MATCH_GIT_USER')}:#{ENV.fetch('MATCH_GIT_TOKEN')}"
  )
end

platform :ios do
  desc "One-time bootstrap: seed this app's App Store profile into the shared"
  desc "match repo. Run from a Mac with the same env vars CI uses. Needs an"
  desc "Admin / App Manager API key — it writes to the portal and the repo."
  lane :bootstrap_signing do
    require_env!(SIGNING_ENV)

    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      readonly: false,
      api_key: asc_api_key,
      git_basic_authorization: match_git_auth
    )
    UI.success("Seeded #{APP_IDENTIFIER} into the match repo. CI can run readonly now.")
  end

  desc "Diagnostic: list the certificates this API key can see on the portal."
  desc "Tells a revoked certificate apart from a key pointed at another team."
  lane :list_certs do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
    certs = Spaceship::ConnectAPI::Certificate.all
    UI.important("#{certs.count} certificate(s) visible to this key:")
    certs.each do |cert|
      UI.message(
        "#{cert.id}  #{cert.certificate_type}  #{cert.name}  expires #{cert.expiration_date}"
      )
    end
  end

  desc "Build QuickIn and upload it to TestFlight"
  lane :beta do
    require_env!(SIGNING_ENV)

    # Creates a throwaway keychain (fastlane_tmp_keychain, empty password) and
    # unlocks it, so match can import the certificate without a UI prompt.
    setup_ci if ENV["CI"]

    api_key = asc_api_key
    team_id = ENV.fetch("APPLE_TEAM_ID")

    # Signing assets come from droob's match repo, which QuickIn shares rather
    # than forking: both apps live in Apple team 97DNR5Y3Y5, so both reuse the
    # single distribution certificate stored there.
    #
    # (Tawazon and mafeshsho8l are in the same Apple team but each got its own
    # match repo and therefore its own certificate — the fragmentation this
    # sharing exists to stop. Folding them in here would be a net win.)
    #
    # An Apple Distribution certificate is per-TEAM, not per-app, and Apple caps
    # how many a team may hold at once. A clean runner has no private key, so
    # `cert`/`sigh` would mint a BRAND NEW certificate on every run and burn
    # through that cap within a handful of builds. readonly: true makes that
    # impossible: CI can only consume what a human already seeded from a Mac
    # (`fastlane match appstore --readonly false`), and every app in the team
    # reuses the one certificate in the repo.
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      team_id: team_id,
      readonly: true,
      api_key: api_key,
      git_basic_authorization: match_git_auth
    )

    # match publishes the profile it installed as sigh_<app id>_<type>_profile-name.
    # The fallback is match's own deterministic name, for the case where a future
    # fastlane stops exporting that variable.
    profile_name = ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"] ||
                   "match AppStore #{APP_IDENTIFIER}"

    # Pin the exact certificate this profile carries, falling back to the name
    # if the profile can't be read (see profile_certificate_sha1 above).
    code_sign_identity =
      profile_certificate_sha1(ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-path"]) ||
      "Apple Distribution"
    UI.message("Signing identity: #{code_sign_identity}")

    # project.yml pins CODE_SIGN_STYLE Automatic under the *development* team so
    # the app builds on a Mac. CI archives for distribution instead, so flip the
    # regenerated project to manual signing under the distribution team.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      team_id: team_id,
      code_sign_identity: code_sign_identity,
      bundle_identifier: APP_IDENTIFIER,
      profile_name: profile_name,
      targets: [SCHEME]
    )

    # Every source of "the last build number" lies in a different direction, so
    # take the highest of all of them. See highest_build_number_on_asc for why
    # the two latest_testflight_build_number calls are not enough on their own:
    #   * any_train  — newest upload overall, which is not the highest-numbered
    #                  one if a train was ever uploaded to out of order,
    #   * this_train — highest this marketing version has seen,
    #   * asc_scan   — highest across every train AND every processing state,
    #   * local      — CURRENT_PROJECT_VERSION from project.yml, a committed
    #                  floor for numbers App Store Connect will not admit to.
    marketing_version = get_version_number(
      xcodeproj: XCODEPROJ,
      target: SCHEME,
      configuration: "Release"
    )
    assert_marketing_version_is_open!(api_key, marketing_version)

    latest_any_train = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      initial_build_number: 0
    )
    latest_this_train = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      version: marketing_version,
      initial_build_number: 0
    )
    asc_scan = highest_build_number_on_asc(api_key)
    local_floor = get_build_number(xcodeproj: XCODEPROJ)

    floors = {
      "newest upload, any train" => latest_any_train.to_i,
      "newest upload, #{marketing_version}" => latest_this_train.to_i,
      "highest build on App Store Connect" => asc_scan.to_i,
      "CURRENT_PROJECT_VERSION in project.yml" => local_floor.to_i
    }
    floors.each { |label, value| UI.message("Build number floor — #{label}: #{value}") }

    next_build_number = floors.values.max + 1
    UI.success("Using build number #{next_build_number}")
    increment_build_number(build_number: next_build_number, xcodeproj: XCODEPROJ)

    build_app(
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "QuickIn",
      clean: true,
      export_options: {
        teamID: team_id,
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
        # exportArchive re-signs, and resolves the certificate from this plist
        # rather than from the project's CODE_SIGN_IDENTITY — so without this
        # the archive signs correctly and then the export fails on the same
        # ambiguous common name. Takes a SHA-1 hash as well as a name.
        signingCertificate: code_sign_identity
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
